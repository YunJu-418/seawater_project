  "drink_session": {
    "vessel_memory_seconds": 1.2,
    "vessel_hand_near_ratio": 0.55,
    "contact_to_disappear_seconds": 1.2,
    "session_timeout_seconds": 15.0,
    "return_confirm_seconds": 0.65,
    "return_position_ratio": 1.1,
    "cooldown_seconds": 3.0,
    "strong_contact_ratio": 0.4,
    "minimum_strong_contact_seconds": 0.18,
    "strong_contact_to_disappear_seconds": 0.8,
