    "low_zone_context_seconds": 3.0,
    "low_zone_y_offset_ratio": 0.85,
    "low_zone_min_distance_ratio": 1.2,
    "minimum_distance_reduction_ratio": 0.32,
    "fast_bite_reduction_ratio": 0.42,
    "minimum_return_distance_increase": 0.25,
    "minimum_return_distance_ratio": 1.0,
