{
  "version": "3.9.0",
  "description": "Confirmed Bite is preserved while a delayed object-hand memory filter selects Meal Bite evidence",
  "camera": {
    "frame_width": 640,
    "frame_height": 480,
    "target_fps": 30,
    "mirror": true,
    "max_frame_gap_seconds": 0.25
  },
  "preprocessing": {
    "brightness_target": 115.0,
    "brightness_low_threshold": 65.0,
    "brightness_high_threshold": 205.0,
    "minimum_blur_score": 35.0,
    "minimum_frame_quality_score": 0.35
  },
  "ema": {
    "hand_position_alpha": 0.45,
    "mouth_position_alpha": 0.4,
    "distance_alpha": 0.35,
    "score_alpha": 0.35
  },
  "hand_pose": {
    "pinch_ratio_threshold": 0.34,
    "grip_finger_ratio_threshold": 0.78,
    "open_finger_ratio_threshold": 1.15
  },
  "holding": {
    "hand_box_expand_ratio": 0.55,
    "max_center_distance_ratio": 1.1,
    "near_center_distance_ratio": 0.55,
    "minimum_object_confidence": 0.18,
    "object_memory_seconds": 0.45,
    "hand_memory_seconds": 0.3,
    "association_memory_seconds": 0.65,
    "stable_distance_ratio": 0.28,
    "stable_angle_degrees": 38.0,
    "minimum_motion_for_comotion": 1.5,
    "maximum_history": 10,
    "holding_on_threshold": 0.58,
    "holding_off_threshold": 0.36,
    "weights": {
      "overlap": 0.3,
      "distance": 0.25,
      "hand_pose": 0.2,
      "spatial_stability": 0.15,
      "comotion": 0.1
    }
  },
  "mouth": {
    "roi_width_face_ratio": 0.38,
    "roi_height_face_ratio": 0.3,
    "near_mouth_enter_ratio": 0.55,
    "near_mouth_exit_ratio": 1.0,
    "minimum_open_ratio": 0.055,
    "occlusion_threshold": 0.45,
    "tracking_memory_seconds": 0.35,
    "occlusion_memory_seconds": 1.0,
    "utensil_near_mouth_enter_ratio": 0.85
  },
  "virtual_plate": {
    "enabled": true,
    "initial_roi": {
      "x_min_ratio": 0.12,
      "y_min_ratio": 0.54,
      "x_max_ratio": 0.88,
      "y_max_ratio": 0.98
