# 이 파일을 .env 로 복사해서 사용하세요.  (.env 는 GitHub에 안 올라감)
#
# ── 모드 선택 ─────────────────────────────────────────────
# [폴백 전용]        USE_LLM=false                → LLM 호출 없음, 고정 문장만 사용
# [로컬 sLLM, 무료]  USE_LLM=true LLM_PROVIDER=ollama  ← 현재 권장 (수행계획서 sLLM 구현)
# [OpenAI API, 유료] USE_LLM=true LLM_PROVIDER=openai  → 크레딧 충전 필요
#
# ── 로컬 sLLM 준비 (개발 PC, 1회) ─────────────────────────
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull exaone3.5:2.4b
# 이후 이 파일 그대로 두면 자동으로 로컬 모델 사용. 요금 0원.

USE_LLM=true
LLM_PROVIDER=ollama

# --- ollama (로컬 sLLM) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=exaone3.5:2.4b

# --- openai (나중에 크레딧 충전 시) ---
OPENAI_API_KEY=sk-여기에-발급받은-키-입력
LLM_MODEL=gpt-4o-mini

LLM_TIMEOUT_SEC=20

# 환자 호칭 (설정하면 모든 안내가 "OOO님," 으로 시작 — 교재 p.184 주체성 강화)
PATIENT_NAME=

# 안내 반복 제어
GUIDANCE_EVENT_COOLDOWN_SEC=30
GUIDANCE_REMIND_BEFORE_END_MIN=30

# 안내 문장의 판단 근거(이벤트/상황/참고정보/생성경로/검증결과)를 터미널에 출력
GUIDANCE_EXPLAIN=true

# 음성 배속 (개발 1.2~1.3 권장 / 실제 환자 배포는 1.0~1.1 — 교재: 천천히 분명하게)
TTS_SPEED=1.25

# TTS 엔진과 목소리 (edge 권장 — scripts/try_voices.py 로 들어보고 선택)
TTS_ENGINE=edge
TTS_VOICE=ko-KR-SunHiNeural
